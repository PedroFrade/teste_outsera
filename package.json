{
  "name": "teste-outsera",
  "version": "1.0.0",
  "description": "REST API for the Golden Raspberry Awards (Worst Picture) producer award intervals",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "start": "node dist/server.js",
    "test": "node --import tsx --test \"test/integration/*.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "better-sqlite3": "^13.1.1",
    "csv-parse": "^7.0.3",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "prettier": "^3.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
